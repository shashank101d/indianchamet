# =============================================
# ChillChat Environment Variables
# NEVER share this file or commit it to GitHub!
# =============================================

# Database — get this from Railway or Supabase
DATABASE_URL=postgresql://user:password@host:5432/chillchat

# Secret key for JWT tokens — make this long and random
# Generate one: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=0afddf0f196cd16df915a963f1dc19572383f6ed2c938aa834305fecb1e23c67

# Stripe — get these from stripe.com → Developers → API Keys
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Cloudinary — get this from cloudinary.com → Dashboard
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
